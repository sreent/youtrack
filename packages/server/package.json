{
  "name": "@a4a/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed-cli.ts",
    "files:to-s3": "tsx src/attachments/copy-cli.ts",
    "apps:pack": "tsx scripts/app-pack.ts"
  },
  "dependencies": {
    "@a4a/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-saml/node-saml": "^5.2.0",
    "@scalar/api-reference": "^1.78.1",
    "@sreent/ocean": "github:sreent/ocean#6e36b53fd5e05c5d36793c74999168e20faef4db",
    "@scalar/hono-api-reference": "^0.12.20",
    "@xmldom/xmldom": "^0.8.15",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.2",
    "hono": "^4.13.18",
    "html-to-text": "10.0.1",
    "imapflow": "^2.12.1",
    "ldapts": "^7.4.0",
    "mailparser": "^3.14.5",
    "nodemailer": "10.3.1",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "0.31.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peculiar/x509": "^3.1.0",
    "@types/busboy": "^1.5.5",
    "@types/html-to-text": "^9.0.4",
    "@types/ldapjs": "^3.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.17",
    "ldapjs": "^3.0.7",
    "reflect-metadata": "^0.2.2",
    "smtp-server": "3.21.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "xml-crypto": "^6.4.0"
  }
}

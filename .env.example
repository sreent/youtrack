# Port for the API server (the web UI is served from the same port in production)
PORT=3000

# Public URL used in links (webhook payloads, MCP setup snippets)
PUBLIC_URL=http://localhost:3000

# Database. Leave DATABASE_URL empty to use the embedded PGlite database in DATA_DIR.
# Set it to a Postgres connection string for production, e.g.
# DATABASE_URL=postgres://a4a:a4a@localhost:5432/a4a
DATABASE_URL=
DATA_DIR=./data

# AI features (triage, duplicate detection, natural-language search and commands,
# chat assistant) use Claude. Without a key the tracker works and AI endpoints return 503.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
AI_MODEL=

# Seed demo data (projects, issues, users) on first start
SEED_DEMO=true

# Single sign-on with an OpenID Connect provider (Okta, Entra ID, Google, Keycloak...).
# Register PUBLIC_URL/api/v1/auth/oidc/callback with the provider as the redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# What the sign-in page calls it, e.g. "Okta"
OIDC_NAME=
# Comma-separated email domains allowed in (empty: any the provider verifies)
OIDC_ALLOWED_DOMAINS=
# Give people an account the first time they sign in
OIDC_CREATE_USERS=false
# Set to false to sign in with the provider only
PASSWORD_LOGIN=true

# Email (notifications, and the help desk's mail to requesters). Without SMTP_URL nothing is sent
# and nothing fails. Example: smtp://user:password@mail.example.com:587
SMTP_URL=
MAIL_FROM=
# Changes to one issue within this many seconds become one notification (and one email)
NOTIFY_WINDOW_SECONDS=120
# The hour (server time) the daily digest goes out
DIGEST_HOUR=8
